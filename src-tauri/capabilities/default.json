{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "completion-alert"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME/*" },
        { "path": "$TEMP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "/tmp/**" },
        { "path": "/private/tmp/**" },
        { "path": "/var/folders/**" },
        { "path": "/Volumes/**" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "file:*" }]
    }
  ]
}
